# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database (Neon PostgreSQL)
# Get this from your Neon dashboard: https://console.neon.tech/
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Server
SERVER_HOST=localhost
SERVER_PORT=8080

# Telemetry
TELEMETRY_WINDOW_SIZE=5s
TELEMETRY_BUFFER_SIZE=120
TELEMETRY_PERSIST_ENABLED=true

# Fault Injection Controls
FAULT_MAX_LATENCY_MS=10000
FAULT_MAX_FAILURE_RATE=1.0
FAULT_MAX_DURATION_SECONDS=300
FAULT_LOCAL_ONLY=true