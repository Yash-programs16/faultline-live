# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file!

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration (Neon PostgreSQL)
# REQUIRED: Set this to your Neon connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Authentication
# REQUIRED: Generate a secure random string for JWT signing
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_TOKEN_EXPIRY=24h
BCRYPT_COST=12

# Ollama/Gemma Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT=60s
OLLAMA_MAX_RETRIES=2
OLLAMA_ENABLED=true

# Fault Injection (Development/Demo only)
FAULTS_ENABLED=false
FAULTS_MAX_DURATION=10m
FAULTS_MAX_LATENCY_MS=10000
FAULTS_MAX_ERROR_RATE=0.5

# Telemetry
TELEMETRY_WINDOW=5m
INCIDENT_COOLDOWN=2m
SAMPLE_RETENTION=24h