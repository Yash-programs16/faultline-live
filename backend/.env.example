# Faultline Live backend environment — local template.
# Copy to `.env` and fill the secrets. NEVER commit `.env` to git.
# For Render, set the same keys in Dashboard → Service → Environment
# (render.yaml already declares them; secrets use `sync: false`).

SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Neon Postgres (required)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth (required, 32+ chars)
JWT_SECRET=change-me-to-a-32-plus-char-random-string
JWT_TOKEN_EXPIRY=24h
BCRYPT_COST=12

# Local AI investigator (Ollama). Disable on Render (no daemon there).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT=60s
OLLAMA_MAX_RETRIES=2
OLLAMA_ENABLED=true

# Cloud AI investigator (Google Gemini via Generative Language API).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=45s
GEMINI_MAX_RETRIES=1
GEMINI_ENABLED=true

# Demo / ops access.
# Local: loopback demo, no login needed.
FAULTLINE_DEMO_MODE=true
ALLOW_PUBLIC_DEMO=false
OPS_AUTH_REQUIRED=false

# Fault injection bounds
FAULTS_ENABLED=true
FAULTS_MAX_DURATION=10m
FAULTS_MAX_LATENCY_MS=10000
FAULTS_MAX_ERROR_RATE=0.5

# Telemetry
TELEMETRY_WINDOW=1m
INCIDENT_COOLDOWN=30s
SAMPLE_RETENTION=24h

# Run SQL migrations on boot (set true on Render, false locally if you
# prefer `go run ./cmd/migrate` manually).
AUTO_MIGRATE=false

# CORS: comma-separated browser origins allowed to call the API.
# Add your Vercel URL here for hosted deploys.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=
