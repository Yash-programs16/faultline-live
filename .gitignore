.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test coverage
coverage/
*.out

# Database
*.db
*.sqlite
*.sqlite3

# Go
vendor/
go.work